{
  "name": "auth-platform/license-sdk",
  "description": "RSA-PSS authenticated PHP client for the Auth license API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "phpseclib/phpseclib": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "AuthPlatform\\LicenseSdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AuthPlatform\\LicenseSdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "check:syntax": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
