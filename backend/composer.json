{
  "name": "auth/platform-api",
  "description": "Auth multi-software license platform API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "topthink/framework": "^8.1",
    "ext-curl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-redis": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "topthink/think-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "check:syntax": "find app tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "license": "proprietary"
}